# API gateway on the production server (api.paridhanemporium.com → nginx → port 4601)
# NEVER set BACKEND_URL to api.paridhanemporium.com — that causes a proxy loop.

GATEWAY_PORT=4601
BACKEND_URL=http://127.0.0.1:4600

# MUST match paridhan-backend JWT_ACCESS_SECRET exactly
JWT_ACCESS_SECRET=change_me_same_as_backend

REDIS_URL=redis://127.0.0.1:6379
REDIS_AUTH_PREFIX=paridhan:auth
